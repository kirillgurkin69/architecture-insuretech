        <mxCell id="42VTCRVAkwf4t-qU9SuP-14" value="Подписка: osago.requested (начать оркестрацию)&lt;div&gt;Публикует: osago.quote-received (per insurer), osago.quoting-completed&lt;/div&gt;&lt;div&gt;[Events]&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="42VTCRVAkwf4t-qU9SuP-13">
